{
  "name": "quancafe-pos",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "tsx server/src/server.ts",
    "dev": "tsx watch server/src/server.ts",
    "tunnel": "ssh -o StrictHostKeyChecking=no -R 80:localhost:3001 nokey@localhost.run",
    "tunnel:cf": ".\\cloudflared.exe tunnel --url http://localhost:3001",
    "tunnel:lt": "npx localtunnel --port 3001"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
